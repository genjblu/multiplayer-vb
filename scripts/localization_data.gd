func _ready() -> void:
	for lang in TRANSLATIONS.keys():
		var t := Translation.new()
		t.locale = lang
		for k in TRANSLATIONS[lang].keys():
			t.add_message(k, TRANSLATIONS[lang][k])
		TranslationServer.add_translation(t)
